diff --git a/include/rex/graphics/gpu_frame_stats.h b/include/rex/graphics/gpu_frame_stats.h
new file mode 100644
--- /dev/null
+++ b/include/rex/graphics/gpu_frame_stats.h
@@ -0,0 +1,39 @@
+/**
+ * @file        graphics/gpu_frame_stats.h
+ * @brief       Per-frame command stream counters for the GPU command processor (gpu_frame_stats).
+ */
+#pragma once
+
+#include <cstdint>
+
+namespace rex::graphics {
+
+// What the guest's command stream asks of the command processor, counted between swaps. Plain
+// increments on the command processor thread (the only thread that runs packets and binds
+// textures); with gpu_frame_stats on, GpuFrameStatsSwap logs per-frame averages every 10 s.
+struct GpuFrameStats {
+  uint64_t frames;
+  uint64_t draws;
+  uint64_t resolves;
+  uint64_t packets_type0;
+  uint64_t packets_type3;
+  uint64_t type0_registers;
+  uint64_t indirect_buffers;
+  // SET_CONSTANT (from the ring) and LOAD_ALU_CONSTANT (from memory), in registers.
+  uint64_t ring_alu_registers;
+  uint64_t ring_fetch_registers;
+  uint64_t ring_bool_loop_registers;
+  uint64_t memory_alu_registers;
+  uint64_t memory_fetch_registers;
+  uint64_t memory_bool_loop_registers;
+  uint64_t shader_loads;
+  uint64_t texture_lookups;
+  uint64_t textures_created;
+};
+
+extern GpuFrameStats g_gpu_frame_stats;
+
+// Called at every guest swap.
+void GpuFrameStatsSwap();
+
+}  // namespace rex::graphics
