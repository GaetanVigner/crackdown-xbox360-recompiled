+void GpuFrameStatsSwap() {
+  GpuFrameStats& stats = g_gpu_frame_stats;
+  ++stats.frames;
+  static std::chrono::steady_clock::time_point start;
+  const auto now = std::chrono::steady_clock::now();
+  if (!REXCVAR_GET(gpu_frame_stats) || start == std::chrono::steady_clock::time_point()) {
+    stats = {};
+    start = REXCVAR_GET(gpu_frame_stats) ? now : std::chrono::steady_clock::time_point();
+    return;
+  }
+  const double seconds = std::chrono::duration<double>(now - start).count();
+  if (seconds < 10.0) {
+    return;
+  }
+  const double frames = double(stats.frames);
+  auto per_frame = [frames](uint64_t value) { return double(value) / frames; };
+  REXGPU_INFO(
+      "Frame stats over {:.1f} s at {:.1f} FPS, per frame: {:.0f} draws, {:.1f} resolves, "
+      "{:.0f} type-0 packets ({:.0f} registers), {:.0f} type-3 packets, {:.1f} indirect "
+      "buffers; constant registers from the ring {:.0f} ALU / {:.0f} fetch / {:.0f} "
+      "bool+loop, from memory {:.0f} ALU / {:.0f} fetch / {:.0f} bool+loop; {:.1f} shader "
+      "loads, {:.0f} texture lookups, {:.2f} textures created",
+      seconds, frames / seconds, per_frame(stats.draws), per_frame(stats.resolves),
+      per_frame(stats.packets_type0), per_frame(stats.type0_registers),
+      per_frame(stats.packets_type3), per_frame(stats.indirect_buffers),
+      per_frame(stats.ring_alu_registers), per_frame(stats.ring_fetch_registers),
+      per_frame(stats.ring_bool_loop_registers), per_frame(stats.memory_alu_registers),
+      per_frame(stats.memory_fetch_registers), per_frame(stats.memory_bool_loop_registers),
+      per_frame(stats.shader_loads), per_frame(stats.texture_lookups),
+      per_frame(stats.textures_created));
+  stats = {};
+  start = now;
+}
